# Copy this file to .env (at the repo root) and fill in real values.
# .env is gitignored -- it is never committed, unlike this template.
#
# Used by util/deploy_kraken.sh (sourced automatically if present) to reach
# the remote KrakenSDR/USRP host. Every one of these was previously
# hardcoded as a fallback default directly in the script -- host, username,
# and remote path all moved here so the script itself carries no reference
# to any specific machine or account.

KRAKEN_HOST=192.168.1.198
KRAKEN_USER=pi
KRAKEN_REPO_PATH=/home/pi/git/heimdall_daq_fw

# Optional, only needed if you want non-interactive deploys. Leave unset to
# be prompted for the password locally instead -- never put a real password
# in this file if it might ever be copied/shared, since .env is local-only
# but unencrypted.
#KRAKEN_SSH_PASS=
